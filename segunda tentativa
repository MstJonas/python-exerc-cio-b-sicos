'''
[1] Somar um número
[2] Mostrar Total
[3] Sair
'''
escolha = 0
soma = 0
escolha = int(input('Qual é a sua opção: 1, 2 ou 3? para sair '))
while escolha != 3:
    if escolha == 1:
        opção = int(input('Qual número você quer somar? '))
        soma +=opção
        print(f'A soma é {soma}')
    elif escolha == 2:
        print(f'{soma}')
    elif escolha == 3:
        print('encerrando')
    escolha = int(input('Qual é a sua opção: 1, 2 ou 3? para sair '))
print('Concluso!')
