'''
[1] Adicionar número
[2] Mostrar Resultados
[3] Sair
'''
soma = 0
quantidade = 0
escolha = int(input('De 1 á 3, escolhe um número: '))
while escolha != 3:
    if escolha == 1:
        n = int(input('Digite um número: '))
        soma += n
        quantidade += 1
    elif escolha == 2 :
        if quantidade > 0 :
            media = soma / quantidade
            print(f'A soma é {soma}\nE a quantidade é {quantidade}\nE a média é {media} ')
        else:
            print('NÃO HÁ VALOR!!')
    escolha = int(input('De 1 á 3, escolhe um número: '))
print('fim')
